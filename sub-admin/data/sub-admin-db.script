ALTER TABLE PUBLIC.PRODUCT_VARIANTS ADD CONSTRAINT FKOSQITN4S405CYNMHB87LKVUAU FOREIGN KEY(PRODUCT_ID) REFERENCES PUBLIC.PRODUCTS(ID)
