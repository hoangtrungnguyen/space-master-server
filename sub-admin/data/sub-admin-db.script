CREATE SCHEMA PUBLIC AUTHORIZATION DBA
CREATE SEQUENCE PUBLIC.PRODUCT_VARIANTS_SEQ AS INTEGER START WITH 1 INCREMENT BY 50
CREATE SEQUENCE PUBLIC.PRODUCTS_SEQ AS INTEGER START WITH 1 INCREMENT BY 50
CREATE MEMORY TABLE PUBLIC.BRANDS(ID BINARY(16) NOT NULL PRIMARY KEY,CREATED_AT TIMESTAMP NOT NULL,NAME VARCHAR(255) NOT NULL,UPDATED_AT TIMESTAMP NOT NULL,CONSTRAINT UKOCE3937D2F4MPFQRYCBR0L93M UNIQUE(NAME))
CREATE MEMORY TABLE PUBLIC.CATEGORIES(ID BINARY(16) NOT NULL PRIMARY KEY,CREATED_AT TIMESTAMP NOT NULL,NAME VARCHAR(255) NOT NULL,UPDATED_AT TIMESTAMP NOT NULL,PARENT_CATEGORY_ID BINARY(16),CONSTRAINT FK9IL7Y6FEHXWUNJEEPQ0N7G5RD FOREIGN KEY(PARENT_CATEGORY_ID) REFERENCES PUBLIC.CATEGORIES(ID))
CREATE MEMORY TABLE PUBLIC.CUSTOMERS(ID BINARY(16) NOT NULL PRIMARY KEY,CREATED_AT TIMESTAMP NOT NULL,EMAIL VARCHAR(255) NOT NULL,FIRST_NAME VARCHAR(100) NOT NULL,LAST_NAME VARCHAR(100) NOT NULL,PHONE_NUMBER VARCHAR(50),UPDATED_AT TIMESTAMP NOT NULL,CONSTRAINT UKRFBVKRFFAMFQL7CJMEN8V976V UNIQUE(EMAIL))
CREATE MEMORY TABLE PUBLIC.INVENTORY(ID BINARY(16) NOT NULL PRIMARY KEY,LAST_RESTOCKED_AT TIMESTAMP,QUANTITY_COMMITTED INTEGER NOT NULL,QUANTITY_ON_HAND INTEGER NOT NULL,REORDER_LEVEL INTEGER NOT NULL,PRODUCT_VARIANT_ID BIGINT NOT NULL,CONSTRAINT UKSMHOSIIWYWEYOOJ1OKKH3TSQS UNIQUE(PRODUCT_VARIANT_ID))
CREATE MEMORY TABLE PUBLIC.INVENTORY_TRANSACTIONS(ID BINARY(16) NOT NULL PRIMARY KEY,CREATED_AT TIMESTAMP NOT NULL,NOTES VARCHAR(255),QUANTITY INTEGER NOT NULL,TYPE VARCHAR(255) NOT NULL,INVENTORY_ID BINARY(16) NOT NULL,CHECK((PUBLIC.INVENTORY_TRANSACTIONS.TYPE) IN (('sale'),('restock'),('return'),('adjustment'))),CONSTRAINT FKR7T3NLRGLE6438PR92JFL4N8S FOREIGN KEY(INVENTORY_ID) REFERENCES PUBLIC.INVENTORY(ID))
CREATE MEMORY TABLE PUBLIC.ORDER_ITEMS(ID BINARY(16) NOT NULL PRIMARY KEY,LINE_TOTAL NUMERIC(38,2) NOT NULL,PRICE_PER_UNIT NUMERIC(38,2) NOT NULL,QUANTITY INTEGER NOT NULL,ORDER_ID BIGINT NOT NULL,PRODUCT_VARIANT_ID BIGINT NOT NULL)
CREATE MEMORY TABLE PUBLIC.ORDERS(ID BIGINT GENERATED BY DEFAULT AS IDENTITY(START WITH 1) NOT NULL PRIMARY KEY,BILLING_ADDRESS VARCHAR(16777216),CREATED_AT TIMESTAMP NOT NULL,ORDER_DATE TIMESTAMP NOT NULL,SHIPPING_ADDRESS VARCHAR(16777216) NOT NULL,STATUS VARCHAR(255) NOT NULL,TOTAL_AMOUNT NUMERIC(38,2) NOT NULL,UPDATED_AT TIMESTAMP NOT NULL,UUID BINARY(16) NOT NULL,CUSTOMER_ID BINARY(16) NOT NULL,CHECK((PUBLIC.ORDERS.STATUS) IN (('PENDING'),('CANCELED'),('PROCESSING'),('SHIPPED'),('DELIVERED'),('FAILED'))),CONSTRAINT UK8TRMQE3EQY2UT1XR2I2ATCAIP UNIQUE(UUID),CONSTRAINT FKPXTB8AWMI0DK6SMOH2VP1LITG FOREIGN KEY(CUSTOMER_ID) REFERENCES PUBLIC.CUSTOMERS(ID))
ALTER TABLE PUBLIC.ORDERS ALTER COLUMN ID RESTART WITH 1
CREATE MEMORY TABLE PUBLIC.PRODUCT_VARIANTS(ID BIGINT NOT NULL PRIMARY KEY,ATTRIBUTES VARCHAR(16777216),COST_PRICE NUMERIC(10,2) NOT NULL,CREATED_AT TIMESTAMP NOT NULL,PRICE NUMERIC(10,2) NOT NULL,SKU VARCHAR(100) NOT NULL,UPDATED_AT TIMESTAMP NOT NULL,WEIGHT NUMERIC(8,2) NOT NULL,PRODUCT_ID BIGINT NOT NULL,CONSTRAINT UKQ935P2D1PBJM39N0063GHNFGN UNIQUE(SKU))
CREATE MEMORY TABLE PUBLIC.PRODUCTS(ID BIGINT NOT NULL PRIMARY KEY,CREATED_AT TIMESTAMP NOT NULL,DESCRIPTION VARCHAR(255),IS_ACTIVE BOOLEAN NOT NULL,NAME VARCHAR(255) NOT NULL,UPDATED_AT TIMESTAMP NOT NULL,BRAND_ID BINARY(16),CATEGORY_ID BINARY(16),CONSTRAINT FKA3A4MPSFDF4D2Y6R8RA3SC8MV FOREIGN KEY(BRAND_ID) REFERENCES PUBLIC.BRANDS(ID),CONSTRAINT FKOG2RP4QTHBTT2LFYHFO32LSW9 FOREIGN KEY(CATEGORY_ID) REFERENCES PUBLIC.CATEGORIES(ID))
CREATE MEMORY TABLE PUBLIC.USERS(ID BINARY(16) NOT NULL PRIMARY KEY,PASSWORD_HASH VARCHAR(255) NOT NULL,ROLE VARCHAR(255) NOT NULL,USERNAME VARCHAR(255) NOT NULL,CHECK((PUBLIC.USERS.ROLE) IN (('MANAGER'),('STAFF'),('INTERN'))),CONSTRAINT UKR43AF9AP4EDM43MMTQ01ODDJ6 UNIQUE(USERNAME))
CREATE MEMORY TABLE PUBLIC.WAREHOUSES(ID BINARY(16) NOT NULL PRIMARY KEY,ADDRESS VARCHAR(255),CREATED_AT TIMESTAMP NOT NULL,NAME VARCHAR(255) NOT NULL,UPDATED_AT TIMESTAMP NOT NULL)
CREATE MEMORY TABLE PUBLIC.PERSISTENT_LOGINS(USERNAME VARCHAR(64) NOT NULL,SERIES VARCHAR(64) PRIMARY KEY,TOKEN VARCHAR(64) NOT NULL,LAST_USED TIMESTAMP NOT NULL)
ALTER TABLE PUBLIC.INVENTORY ADD CONSTRAINT FKRH3AH6QWGO1PIPVXJBY2A7208 FOREIGN KEY(PRODUCT_VARIANT_ID) REFERENCES PUBLIC.PRODUCT_VARIANTS(ID)
