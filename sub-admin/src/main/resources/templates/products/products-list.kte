@import com.space.subadmin.products.ProductVariantInventoryDTO

@param products: List<ProductVariantInventoryDTO>

<!DOCTYPE html>
<html>
<head>
    <title>Product List</title>
</head>
<body>
    <h1>Product List</h1>
    <table>
        <thead>
            <tr>
                <th>Product</th>
                <th>Variant</th>
                <th>SKU</th>
                <th>Price</th>
                <th>Stock</th>
            </tr>
        </thead>
        <tbody>
            @if(products.isNotEmpty())
                @for(product in products)
                    <tr>
                        <td>${product.productName}</td>
                        <td>${product.variantName}</td>
                        <td>${product.variantSku}</td>
                        <td>${product.price}</td>
                        <td>${product.quantityOnHand}</td>
                    </tr>
                @endfor
            @else
                <tr>
                    <td colspan="5">No products found.</td>
                </tr>
            @endif
        </tbody>
    </table>
</body>
</html>
