@import com.space.subadmin.dashboard.DashboardUiDto

@param dashboardData: com.space.subadmin.dashboard.DashboardUiDto

<!DOCTYPE html>
<html lang="en">

<head>
    @template.fragments.header(title = "Admin Dashboard")
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/moment@2.29.1/moment.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chartjs-adapter-moment@1.0.0"></script>
</head>

<body class="bg-gray-100">

@template.fragments.navbar()

<div class="container mx-auto p-8">
    <h1 class="text-3xl font-bold mb-6 text-gray-800">Admin Dashboard</h1>

    <!-- Stats -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
        <div class="bg-white p-6 rounded-lg shadow-md">
            <h2 class="text-sm font-medium text-gray-500">Gross Profit Margin</h2>
            <p class="text-3xl font-semibold text-gray-800">
                ${dashboardData.grossProfitMargin}
            </p>
        </div>
        <div class="bg-white p-6 rounded-lg shadow-md">
            <h2 class="text-sm font-medium text-gray-500">New Customers</h2>
            <p class="text-3xl font-semibold text-gray-800">${dashboardData.newCustomers}</p>
        </div>
        <div class="bg-white p-6 rounded-lg shadow-md">
            <h2 class="text-sm font-medium text-gray-500">Avg. Order Value</h2>
            <p class="text-3xl font-semibold text-gray-800">
                ${dashboardData.averageOrderValue}
            </p>
        </div>
        <div class="bg-white p-6 rounded-lg shadow-md">
            <h2 class="text-sm font-medium text-gray-500">Customer Retention Rate</h2>
            <p class="text-3xl font-semibold text-gray-800">
                ${dashboardData.customerRetentionRate}
            </p>
        </div>
    </div>

    <!-- Charts and Top Products -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <div class="lg:col-span-2 bg-white p-6 rounded-lg shadow-md">
            <h2 class="text-xl font-semibold text-gray-800 mb-4">Revenue Trend (Last 30 Days)</h2>
            <canvas id="revenueChart"></canvas>
        </div>
        <div class="bg-white p-6 rounded-lg shadow-md">
            <h2 class="text-xl font-semibold text-gray-800 mb-4">Top Selling Products</h2>
            <ul class="space-y-4">
                @if(dashboardData.topSellingProducts.isEmpty())
                    <li>
                        <p class="text-gray-500">No sales data available.</p>
                    </li>
                @else
                    @for(product in dashboardData.topSellingProducts)
                        <li class="flex items-center">
                            <svg class="w-16 h-16 text-gray-300" fill="currentColor" viewBox="0 0 24 24">
                                <path d="M24 20.993V24H0v-2.993A2 2 0 002 19h20a2 2 0 002 1.993zM2 4h20v12H2V4z" />
                            </svg>
                            <div class="ml-4 flex-grow">
                                <p class="font-medium text-gray-800">${product.productName}</p>
                                <p class="text-sm text-gray-500">${product.totalQuantity}</p>
                            </div>
                            <p class="font-semibold text-green-600">
                                ${product.totalRevenue}
                            </p>
                        </li>
                    @endfor
                @endif
            </ul>
        </div>
    </div>
</div>

<script>
    const revenueData = "${dashboardData.revenueTrend}";
    // const labels = Object.keys(revenueData);
    // const dataPoints = Object.values(revenueData);

    const labels = "2025-17-01"

    const ctx = document.getElementById('revenueChart').getContext('2d');
    const revenueChart = new Chart(ctx, {
        type: 'line',
        data: {
            labels: labels,
            datasets: [{
                label: 'Daily Revenue',
                data: dataPoints,
                backgroundColor: 'rgba(79, 70, 229, 0.1)',
                borderColor: 'rgba(79, 70, 229, 1)',
                borderWidth: 2,
                tension: 0.3,
                fill: true
            }]
        },
        options: {
            responsive: true,
            scales: {
                x: {
                    type: 'time',
                    time: {
                        unit: 'day',
                        tooltipFormat: 'll'
                    },
                    grid: {
                        display: false
                    }
                },
                y: {
                    beginAtZero: true,
                    ticks: {
                        callback: function (value, index, values) {
                            return '$' + value.toLocaleString();
                        }
                    }
                }
            }
        }
    });
</script>
</body>
</html>
