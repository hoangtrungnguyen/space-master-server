@import com.space.subadmin.orders.OrderDetail

@param order: OrderDetail

<!DOCTYPE html>
<html>
<head>
    @template.fragments.header(title = "Confirm Payment for Order " + order.uuid)
</head>
<body class="bg-gray-100">

@template.fragments.navbar()

<div class="container mx-auto p-8">
    <div class="bg-white p-8 rounded-lg shadow-lg">
        <h1 class="text-2xl font-bold text-gray-800 mb-6">Confirm Payment for Order #${order.uuid}</h1>

        <div class="mb-6">
            <h2 class="text-xl font-semibold text-gray-700 mb-4">Order Summary</h2>
            <div class="grid grid-cols-2 gap-4">
                <div>
                    <p class="text-sm font-medium text-gray-500">Order UUID</p>
                    <p class="text-lg text-gray-900">${order.uuid}</p>
                </div>
                <div>
                    <p class="text-sm font-medium text-gray-500">Order Date</p>
                    <p class="text-lg text-gray-900">${order.orderDate}</p>
                </div>
                <div>
                    <p class="text-sm font-medium text-gray-500">Customer</p>
                    <p class="text-lg text-gray-900">${order.customerName}</p>
                </div>
                <div>
                    <p class="text-sm font-medium text-gray-500">Total Amount</p>
                    <p class="text-lg font-bold text-gray-900">$${order.totalAmount}</p>
                </div>
            </div>
        </div>

        <div class="mb-6">
            <h3 class="text-lg font-semibold text-gray-700 mb-2">Items</h3>
            <ul class="divide-y divide-gray-200">
                @for(item in order.items)
                    <li class="py-2 flex justify-between">
                        <span>${item.productName} (x${item.quantity})</span>
                        <span>$${item.lineTotal}</span>
                    </li>
                @endfor
            </ul>
        </div>

        <form action="/orders/${order.uuid}/confirm-payment" method="post">
            <div class="mb-4">
                <label for="paymentMethod" class="block text-sm font-medium text-gray-700">Payment Method</label>
                <select id="paymentMethod" name="paymentMethod" class="mt-1 block w-full pl-3 pr-10 py-2 text-base border-gray-300 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm rounded-md">
                    <option value="CASH" selected>Cash</option>
                </select>
            </div>
             <div class="mb-4">
                <label for="amount" class="block text-sm font-medium text-gray-700">Amount Received</label>
                <input type="number" id="amount" name="amount" value="${order.totalAmount}" step="0.01" class="mt-1 block w-full pl-3 pr-10 py-2 text-base border-gray-300 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm rounded-md" required>
            </div>

            <div class="flex justify-end">
                <a href="/orders" class="bg-gray-300 hover:bg-gray-400 text-gray-800 font-bold py-2 px-4 rounded-lg mr-2">
                    Cancel
                </a>
                <button type="submit" class="bg-green-600 hover:bg-green-700 text-white font-bold py-2 px-4 rounded-lg">
                    Confirm Payment
                </button>
            </div>
        </form>
    </div>
</div>

</body>
</html>
