@param  labelsJson: String
@param  dataJson: String

@param transactionLabels: String
@param transactionData: String
<!-- Chart 1: Revenue & Profit Margin Over Time (Line Chart) -->
<div class="lg:col-span-3 bg-white p-6 rounded-lg shadow-md">
    <h2 class="text-xl font-semibold text-gray-700 mb-4">Revenue & Profit Margin</h2>
    <div class="h-80">
        <canvas id="revenueProfitChart"></canvas>
    </div>
</div>

<!-- Chart 2: Transactions Over Time (Bar Chart) -->
<div class="lg:col-span-2 bg-white p-6 rounded-lg shadow-md">
    <h2 class="text-xl font-semibold text-gray-700 mb-4">Transactions</h2>
    <div class="h-80">
        <canvas id="transactionsChart"></canvas>
    </div>
</div>


<script>
    // Use a function to avoid polluting the global scope
    (function () {
        // 1. If a chart instance already exists on the window, destroy it.
        //    This prevents memory leaks when swapping.
        if (window.myRevenueChart) {
            window.myRevenueChart.destroy();
        }

        // 2. Get the canvas context
        var ctx = document.getElementById('revenueProfitChart').getContext('2d');

        const labelData = $unsafe{labelsJson};
        // 3. Create the new chart
        window.myRevenueChart = new Chart(ctx, {
            type: 'line',
            data: {
                // 4. Use the raw JSON data from our JTE parameters
                labels: labelData,
                datasets: [{
                    label: 'Revenue',
                    data: ${ dataJson},
                    borderColor: 'rgb(75, 192, 192)',
                    tension: 0.1
                }]
            },
            options: {
                animation: false // Turn off animation for faster-feeling swaps
            }
        });
    })();
</script>

<script>
    (function () {
        if (window.transactionChart) {
            window.transactionChart.destroy();
        }

        var ctx = document.getElementById('transactionsChart').getContext('2d');

        const labelTransactions = $unsafe{transactionLabels};

        window.transactionChart = new Chart(ctx, {
            type: 'bar',
            data: {
                labels: labelTransactions,
                datasets: [{
                    label: 'Transaction',
                    data: ${ transactionData},
                    borderColor: 'rgb(75, 192, 192)',
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
            }
        });
    })();
</script>