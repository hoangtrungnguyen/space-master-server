@import com.space.subadmin.products.ProductFormDTO
@param productForm: ProductFormDTO
@param isEdit: Boolean = false
@param productId: Long? = null


<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>${if(isEdit) "Edit Product" else "Add New Product"}</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/css/main.css">
</head>
<body class="bg-gray-100 font-sans leading-normal tracking-normal">

<div class="container mx-auto p-8">
    <form method="post" action="${if(isEdit && productForm.productId != null) "/products/edit/" + productId else "/products/add"}">
        <div class="flex justify-between items-center mb-6">
            <h1 class="text-2xl font-bold text-gray-800">
                ${if(isEdit) "Edit Product" else "Add New Product" }
            </h1>
            <div>
                <a class="font-medium text-indigo-600 hover:text-indigo-500 mr-4" href="/products/list">Back to Product List</a>
                <button class="flex justify-center py-2 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500"
                        type="submit">
                    @if(isEdit)Update Product@elseSave Product@endif
                </button>
            </div>
        </div>

        <div class="grid grid-cols-2 gap-8">
            <!-- Left Column: Form Fields -->
            <div class="space-y-6">
                <div>
                    <label class="block text-sm font-medium text-gray-700" for="name">Product Name:</label>
                    <input class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm placeholder-gray-400 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm"
                           id="name" name="name" required
                           value="${productForm.name}"
                           type="text"/>
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700" for="categoryId">Category:</label>
                    <input class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm placeholder-gray-400 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm"
                           id="categoryId" name="categoryId"
                           value="${productForm.categoryId}"
                           type="number"/>
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700" for="description">Description (Markdown):</label>
                    <textarea
                            class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm placeholder-gray-400 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm"
                            id="description" name="description"
                            rows="20" placeholder="Enter product description in Markdown format">${productForm.description}</textarea>
                </div>
            </div>

            <!-- Right Column: Markdown Preview -->
            <div>
                <label class="block text-sm font-medium text-gray-700">Preview:</label>
                <div id="preview" class="mt-1 p-3 border border-gray-300 rounded-md bg-white min-h-[400px] prose"></div>
            </div>
        </div>
    </form>
</div>

<script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
<script>
    const descriptionTextarea = document.getElementById('description');
    const previewDiv = document.getElementById('preview');

    function updatePreview() {
        previewDiv.innerHTML = marked.parse(descriptionTextarea.value);
    }

    descriptionTextarea.addEventListener('input', updatePreview);

    // Initial preview update
    updatePreview();
</script>

</body>

</html>